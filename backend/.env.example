NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Local setup defaults to MySQL; PostgreSQL is also supported.
DB_CLIENT=mysql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mitti
DB_PASSWORD=mitti_local_password
DB_NAME=mitti
DB_POOL_SIZE=12
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=mitti
JWT_SECRET=replace-this-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
TRUST_PROXY=0
UPLOAD_DIR=uploads
UPLOAD_STORAGE=filesystem
EMBEDDED_WORKER=true
# Native defaults. For the documented Netlify polling proxy, set both to 10000.
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
# mock is a labelled local-only simulator. razorpay requires rzp_test_ credentials.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# simulated never sends externally. configured uses supplied providers; disabled skips.
NOTIFICATION_MODE=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MAP_ENABLED=true
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional personal local demo profile in addition to fictional demo accounts.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PHONE=
DEMO_CUSTOMER_NAME=
SEED_PASSWORD=DemoOnly123!

# Google sign-in is disabled until a web client ID is supplied (no client secret).
GOOGLE_CLIENT_ID=
# Simulated codes are shown only in development; real SMS may incur provider charges.
PHONE_OTP_MODE=simulated

# Browser-only reverse lookup after a fresh explicit location permission. No server proxy.
# Set disabled to use only manual addresses. No API key is needed for this client endpoint.
LOCATION_PROVIDER=bigdatacloud
