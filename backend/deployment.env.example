# Template only: set real secrets in the hosting service's protected environment.
# Do not commit a filled-in copy or run the development seed on this database.
NODE_ENV=production
NODE_VERSION=24.22.3
HOST=0.0.0.0
# Render supplies PORT. For a different host, set its assigned listening port.
JWT_SECRET=
ALLOWED_ORIGINS=https://your-store.netlify.app
# One trusted edge is conservative. Verify forwarded-client IPs for the real proxy
# topology before launch; never increase this blindly while the API is public.
TRUST_PROXY=1
DB_HOST=your-private-mysql-host
DB_PORT=3306
DB_NAME=virar_store
DB_USER=virar_app
DB_PASSWORD=
DB_POOL_SIZE=12
REDIS_URL=redis://your-private-redis-host:6379
REDIS_PREFIX=virar-staging
UPLOAD_DIR=/var/data/uploads
EMBEDDED_WORKER=true
# Polling proxy budget:10s heartbeat +10s timeout is below Netlify's26s limit.
SOCKET_PING_INTERVAL_MS=10000
SOCKET_PING_TIMEOUT_MS=10000
PAYMENT_MODE=disabled
PHONE_OTP_MODE=disabled
NOTIFICATION_MODE=disabled
GOOGLE_CLIENT_ID=
MAP_ENABLED=false
LOCATION_PROVIDER=disabled
# Supply these three only for the explicit, one-time bootstrap command.
# Remove them from the host environment after success.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
